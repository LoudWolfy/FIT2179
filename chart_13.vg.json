{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "concat": {
      "spacing": 40
    },
    "view": {
      "stroke": null
    }
  },
  "title": "13. Indo-Pacific Region: Last Known Eruptions by Century (Post-1500 CE)",
  "width": 800,
  "height": 300,
  "data": {
    "url": "data/indopac_eruptions.csv"
  },
  "params": [
    {
      "name": "regionHighlight",
      "select": {
        "type": "point",
        "fields": [
          "Region"
        ]
      },
      "bind": "legend"
    }
  ],
  "transform": [
    {
      "filter": "datum.Century == '1500' || datum.Century == '1600' || datum.Century == '1700' || datum.Century == '1800' || datum.Century == '1900' || datum.Century == '2000'"
    }
  ],
  "mark": {
    "type": "area"
  },
  "encoding": {
    "x": {
      "field": "Century",
      "type": "ordinal",
      "title": "Century",
      "sort": [
        "1500",
        "1600",
        "1700",
        "1800",
        "1900",
        "2000"
      ]
    },
    "y": {
      "field": "Count",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Proportion of Eruptions",
      "axis": {
        "format": "%"
      }
    },
    "color": {
      "field": "Region",
      "type": "nominal",
      "title": "Indo-Pacific Sub-Region",
      "scale": {
        "scheme": "tableau10"
      }
    },
    "opacity": {
      "condition": {
        "param": "regionHighlight",
        "value": 1
      },
      "value": 0.2
    },
    "tooltip": [
      {
        "field": "Region",
        "title": "Region"
      },
      {
        "field": "Century",
        "title": "Century"
      },
      {
        "field": "Count",
        "title": "Eruption Count"
      }
    ]
  }
}