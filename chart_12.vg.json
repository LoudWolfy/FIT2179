{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "concat": {
      "spacing": 40
    },
    "view": {
      "stroke": null
    }
  },
  "title": "12. Explosivity Densities of Australia's Immediate Maritime Neighbors",
  "width": 800,
  "height": 300,
  "data": {
    "url": "data/neighbor_vei_data.csv"
  },
  "mark": "area",
  "transform": [
    {
      "filter": "datum.VEI != 'NULL' && datum.VEI != null"
    },
    {
      "calculate": "toNumber(datum.VEI)",
      "as": "VEI_num"
    },
    {
      "density": "VEI_num",
      "groupby": [
        "Country"
      ],
      "extent": [
        0,
        7
      ],
      "as": [
        "value",
        "density"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Eruptive VEI Footprint Range"
    },
    "y": {
      "field": "density",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "Country",
      "type": "nominal",
      "legend": null
    },
    "row": {
      "field": "Country",
      "type": "nominal",
      "title": "Neighbor Proximity Country Line Matrix"
    }
  }
}