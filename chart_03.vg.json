{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "view": {
      "stroke": null
    }
  },
  "title": "3. Volcano Elevation Metrics Distributed by Main Rock Chemistries",
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/box_plot_data.csv"
  },
  "transform": [
    {
      "filter": "datum['Rock Type'] != 'No Data (checked)' && datum['Rock Type'] != 'NA' && datum['Rock Type'] != null && datum['Rock Type'] != ''"
    }
  ],
  "mark": {
    "type": "boxplot",
    "extent": "min-max"
  },
  "encoding": {
    "y": {
      "field": "Rock Type",
      "type": "nominal",
      "title": "Rock Type",
      "sort": {
        "op": "median",
        "field": "Elevation",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 220
      }
    },
    "x": {
      "field": "Elevation",
      "type": "quantitative",
      "title": "Elevation (metres)"
    },
    "color": {
      "field": "Rock Type",
      "type": "nominal",
      "legend": null
    },
    "tooltip": [
      {
        "field": "Rock Type",
        "title": "Rock Type"
      },
      {
        "field": "Elevation",
        "title": "Elevation (m)",
        "type": "quantitative"
      }
    ]
  }
}