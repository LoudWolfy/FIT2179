{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "concat": {
      "spacing": 40
    },
    "view": {
      "stroke": null
    }
  },
  "title": "9. Shifting Fatality Vectors Profile (19th vs 20th Century Dynamics)",
  "width": 800,
  "height": 300,
  "data": {
    "url": "data/slope_chart_data.csv"
  },
  "mark": {
    "type": "line",
    "point": true
  },
  "encoding": {
    "x": {
      "field": "Era",
      "type": "nominal",
      "title": "Historical Phase Period"
    },
    "y": {
      "field": "Event_Count",
      "type": "quantitative",
      "title": "Incident Event Counts Across Era"
    },
    "color": {
      "field": "Agent_Name",
      "type": "nominal"
    }
  }
}