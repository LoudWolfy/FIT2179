{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "concat": {
      "spacing": 40
    },
    "view": {
      "stroke": null
    }
  },
  "title": "5. Human Observation Reporting Bias Growth Curves (Since 1500)",
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/reporting_bias.csv"
  },
