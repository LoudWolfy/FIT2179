{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Distribution Map of Tectonic Settings",
    "subtitle": "Comparing Holocene (Active) vs. Pleistocene (Prehistoric) Volcanic Formations",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "anchor": "start",
    "color": "#1e293b",
    "subtitleColor": "gray"
  },
  "width": 1200,
  "height": 700,
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "zoom_level",
      "value": "Wide Global (1x)",
      "bind": {
        "input": "select",
        "options": [
          "Wide Global (1x)",
          "Continental View (2.5x)",
          "Regional View (4x)",
          "Local Context (6x)",
          "Deep Zoom (15x)"
        ],
        "name": "Select Zoom Level: "
      }
    },
    {
      "name": "continent",
      "value": "Global",
      "bind": {
        "input": "select",
        "options": [
          "Global",
          "North America",
          "South America",
          "Europe",
          "Africa",
          "Asia",
          "Southeast Asia & Pacific",
          "Oceania",
          "Antarctica"
        ],
        "name": "Focus Region: "
      }
    },
    {
      "name": "center_lon",
      "value": 0,
      "bind": {
        "input": "range",
        "min": -180,
        "max": 180,
        "step": 1,
        "name": "Center Longitude: "
      }
    },
    {
      "name": "center_lat",
      "value": 0,
      "bind": {
        "input": "range",
        "min": -90,
        "max": 90,
        "step": 1,
        "name": "Center Latitude: "
      }
    }
  ],
  "projection": {
    "type": "equalEarth",
    "scale": {
      "expr": "zoom_level == 'Wide Global (1x)' ? 220 : zoom_level == 'Continental View (2.5x)' ? 425 : zoom_level == 'Regional View (4x)' ? 680 : zoom_level == 'Local Context (6x)' ? 1020 : 2550"
    },
    "center": {
      "expr": "continent == 'Global' ? [center_lon, center_lat] : continent == 'North America' ? [-100, 45] : continent == 'South America' ? [-60, -15] : continent == 'Europe' ? [15, 50] : continent == 'Africa' ? [20, 5] : continent == 'Asia' ? [80, 40] : continent == 'Southeast Asia & Pacific' ? [130, 5] : continent == 'Oceania' ? [150, -25] : [0, -80]"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f7ff"
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ffffff",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/PB2002_boundaries.json",
        "format": {
          "type": "json"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#e65c00",
        "strokeWidth": 2,
        "strokeDash": [
          6,
          4
        ],
        "strokeCap": "round",
        "strokeJoin": "round"
      },
      "encoding": {}
    },
    {
      "data": {
        "url": "data/phleistocene.csv"
      },
      "transform": [
        {
          "filter": "datum['Latitude'] != 'NA' && datum['Latitude'] != null && datum['Latitude'] != ''"
        }
      ],
      "mark": {
        "type": "text",
        "text": "\ud83e\udea8",
        "fontSize": 11,
        "opacity": 0.45,
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Volcano Name",
            "title": "Volcano Name"
          },
          {
            "field": "Country",
            "type": "nominal"
          },
          {
            "field": "Volcanic Region Group",
            "title": "Volcanic Domain Zone"
          },
          {
            "field": "Elevation (m)",
            "title": "Summit Peak Elevation (m)"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/holocene.csv"
      },
      "transform": [
        {
          "filter": "datum['Latitude'] != 'NA' && datum['Latitude'] != null && datum['Latitude'] != ''"
        }
      ],
      "mark": {
        "type": "text",
        "text": "\ud83c\udf0b",
        "fontSize": 15,
        "opacity": 0.95,
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Volcano Name",
            "title": "Active Volcano"
          },
          {
            "field": "Country",
            "type": "nominal"
          },
          {
            "field": "Volcanic Region Group",
            "title": "Volcanic Domain Zone"
          },
          {
            "field": "Last Known Eruption",
            "title": "Last Recorded Eruption Activity"
          }
        ]
      }
    }
  ]
}