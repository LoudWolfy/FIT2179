{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "concat": {
      "spacing": 40
    },
    "view": {
      "stroke": null
    }
  },
  "title": "4. Historical Event Magnitudes (Volcanic Explosivity Index Baseline)",
  "width": 800,
  "height": 250,
  "data": {
    "url": "data/events_processed.csv"
  },
  "transform": [
    {
      "filter": "datum.VEI != null"
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "VEI",
      "type": "ordinal",
      "title": "VEI Scale Value"
    },
    "y": {
      "aggregate": "count",
      "title": "Recorded Historic Events"
    },
    "color": {
      "value": "#d94801"
    }
  }
}